# API
PORTA=8000
NIVEL_LOG=INFO

# Banco (as três primeiras são lidas pelo docker compose)
BANCO_ADMIN_SENHA=troque-senha-admin
BANCO_APP_USUARIO=raizes_app
BANCO_APP_SENHA=troque-senha-app
BANCO_URL=postgresql+psycopg://raizes_app:troque-senha-app@127.0.0.1:5432/raizes
BANCO_URL_TESTE=postgresql+psycopg://raizes_app:troque-senha-app@127.0.0.1:5432/raizes_teste

# Autenticação (gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SEGREDO=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=60

# Gateway de pagamento simulado
GATEWAY_TIMEOUT_SEGUNDOS=3
