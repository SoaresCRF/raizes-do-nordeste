---
config:
  theme: base
  layout: elk
  elk:
    forceNodeModelOrder: true
    nodePlacementStrategy: NETWORK_SIMPLEX
  fontFamily: "Segoe UI, Arial, sans-serif"
  themeVariables:
    fontSize: 15px
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#7B8794"
    primaryTextColor: "#1F2933"
    lineColor: "#616E7C"
    clusterBkg: "#F1F4F8"
    clusterBorder: "#9AA5B1"
    edgeLabelBackground: "#FFFFFF"
    dropShadow: none
---
usecase-beta
    direction LR
    actor cliente("Cliente (App, Web, Totem, Pickup)")
    systemBoundary "API Raízes do Nordeste"
      uc02("UC02 Cadastrar-se e gerir consentimento")
      uc03("UC03 Consultar cardápio da unidade")
      uc07("UC07 Resgatar pontos")
      uc04("UC04 Realizar pedido")
      uc05("UC05 Validar estoque")
      uc06("UC06 Solicitar pagamento")
      uc01("UC01 Autenticar")
      uc08("UC08 Acompanhar pedido")
      uc10("UC10 Cancelar pedido")
      uc09("UC09 Atualizar status do pedido")
      uc11("UC11 Gerir unidades e produtos (só Administrador)")
      uc12("UC12 Movimentar estoque")
      uc13("UC13 Consultar auditoria")
    end

    actor gateway("Gateway de pagamento (externo, mock)")
    actor atendente("Atendente (Balcão)")
    actor cozinha("Cozinha")
    actor gerente("Gerente / Administrador")

    cliente --- uc01
    cliente --- uc02
    cliente --- uc03
    cliente --- uc04
    cliente --- uc06
    cliente --- uc07
    cliente --- uc08
    cliente --- uc10

    uc01 --- atendente
    uc04 --- atendente
    uc06 --- atendente
    uc08 --- atendente
    uc09 --- atendente
    uc10 --- atendente
    uc01 --- cozinha
    uc08 --- cozinha
    uc09 --- cozinha
    uc01 --- gerente
    uc08 --- gerente
    uc09 --- gerente
    uc10 --- gerente
    uc11 --- gerente
    uc12 --- gerente
    uc13 --- gerente
    uc06 --- gateway

    uc04 ..> : include uc05
    uc07 ..> : extend uc04
