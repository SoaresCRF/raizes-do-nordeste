---
config:
  theme: base
  layout: elk
  elk:
    nodePlacementStrategy: NETWORK_SIMPLEX
  fontFamily: "Segoe UI, Arial, sans-serif"
  themeVariables:
    fontSize: 15px
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#7B8794"
    primaryTextColor: "#1F2933"
    lineColor: "#616E7C"
    edgeLabelBackground: "#FFFFFF"
    dropShadow: none
---
classDiagram
    direction LR

    class Unidade {
        +int id
        +str nome
        +str cidade
        +str uf
        +str regiao
        +TipoUnidade tipo
        +bool ativa
    }
    class Usuario {
        +int id
        +str nome
        +str email
        +str senha_hash
        +Perfil perfil
        +int unidade_id
        +bool ativo
        +datetime anonimizado_em
    }
    class Consentimento {
        +int id
        +int usuario_id
        +FinalidadeConsentimento finalidade
        +bool concedido
        +str versao_termo
        +datetime registrado_em
    }
    class Sessao {
        +int id
        +int usuario_id
        +datetime revogada_em
    }
    class Produto {
        +int id
        +str nome
        +str descricao
        +Decimal preco
        +bool ativo
    }
    class Estoque {
        +int id
        +int unidade_id
        +int produto_id
        +int quantidade
    }
    class MovimentacaoEstoque {
        +int id
        +int estoque_id
        +TipoMovimentacao tipo
        +int quantidade
        +str motivo
        +int pedido_id
        +int usuario_id
    }
    class Pedido {
        +int id
        +int cliente_id
        +int unidade_id
        +CanalPedido canal_pedido
        +StatusPedido status
        +FormaPagamento forma_pagamento
        +Decimal subtotal
        +Decimal desconto
        +Decimal total
        +int criado_por_id
        +str motivo_cancelamento
    }
    class ItemPedido {
        +int id
        +int pedido_id
        +int produto_id
        +int quantidade
        +Decimal preco_unitario
    }
    class Pagamento {
        +int id
        +int pedido_id
        +StatusPagamento status
        +Decimal valor
        +FormaPagamento forma_pagamento
        +str transacao_externa_id
        +str motivo_recusa
        +dict payload_gateway
    }
    class TransacaoFidelidade {
        +int id
        +int cliente_id
        +TipoTransacaoFidelidade tipo
        +int pontos
        +int pedido_id
    }
    class LogAuditoria {
        +int id
        +int usuario_id
        +int unidade_id
        +str acao
        +str entidade
        +int entidade_id
        +dict dados_antes
        +dict dados_depois
        +str request_id
    }
    class GatewayPagamento {
        <<interface>>
        +cobrar(referencia: int, valor: Decimal) RespostaCobranca*
    }
    class GatewayPagamentoMock {
        +cobrar(referencia: int, valor: Decimal) RespostaCobranca
    }

    class TipoUnidade {
        <<enumeration>>
        COZINHA_COMPLETA
        FORMATO_REDUZIDO
    }
    class TipoMovimentacao {
        <<enumeration>>
        ENTRADA
        SAIDA
    }
    class TipoTransacaoFidelidade {
        <<enumeration>>
        ACUMULO
        RESGATE
        ESTORNO
    }
    class Perfil {
        <<enumeration>>
        CLIENTE
        ATENDENTE
        COZINHA
        GERENTE
        ADMIN
    }
    class CanalPedido {
        <<enumeration>>
        APP
        TOTEM
        BALCAO
        PICKUP
        WEB
    }
    class StatusPedido {
        <<enumeration>>
        AGUARDANDO_PAGAMENTO
        EM_PREPARO
        PRONTO
        ENTREGUE
        CANCELADO
    }
    class StatusPagamento {
        <<enumeration>>
        APROVADO
        RECUSADO
        ERRO
    }

    Unidade "0..1" -- "*" Usuario : lota
    Usuario "1" -- "*" Consentimento : concede
    Usuario "1" -- "*" Sessao : abre
    Unidade "1" *-- "*" Estoque : possui
    Produto "1" -- "*" Estoque : estocado em
    Estoque "1" *-- "*" MovimentacaoEstoque : registra
    Usuario "1" -- "*" MovimentacaoEstoque : executa
    Pedido "0..1" -- "*" MovimentacaoEstoque : origina
    Unidade "1" -- "*" Pedido : recebe
    Usuario "0..1" -- "*" Pedido : faz
    Usuario "1" -- "*" Pedido : registra
    Pedido "1" *-- "1..*" ItemPedido : contém
    Produto "1" -- "*" ItemPedido : vendido em
    Pedido "1" -- "*" Pagamento : tentativas
    Pedido "1" -- "*" TransacaoFidelidade : origina
    Usuario "1" -- "*" TransacaoFidelidade : acumula
    Usuario "0..1" -- "*" LogAuditoria : executa
    Unidade "0..1" -- "*" LogAuditoria : escopo de
    GatewayPagamentoMock ..|> GatewayPagamento
    Usuario --> Perfil
    Pedido --> CanalPedido
    Pedido --> StatusPedido
    Pagamento --> StatusPagamento
    Unidade --> TipoUnidade
    MovimentacaoEstoque --> TipoMovimentacao
    TransacaoFidelidade --> TipoTransacaoFidelidade
