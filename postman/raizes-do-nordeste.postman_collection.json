            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\": \"TOTEM\", \"unidadeId\": 1, \"itens\": [{\"produtoId\": 5, \"quantidade\": 2}, {\"produtoId\": 1, \"quantidade\": 1}], \"formaPagamento\": \"MOCK\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
