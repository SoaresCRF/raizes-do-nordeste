                  "    const ids = pm.response.json().dados.map(function (item) { return item.produtoId; });",
                  "    // Seed: os produtos 1 a 6 são ofertados em Recife.",
                  "    pm.expect(ids.slice().sort()).to.eql([1, 2, 3, 4, 5, 6]);",
                  "});"
